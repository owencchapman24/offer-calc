{
  "name": "offer-calc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job offer comparison calculator: correct after-tax, location-adjusted, year-by-year comparisons.",
  "scripts": {
    "test": "vitest run && tsx scripts/check-engine.ts",
    "typecheck": "tsc -p . && tsc -p scripts && tsc -p app && tsc -p e2e",
    "lint": "eslint app/src",
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "grid": "tsx scripts/grid.ts > grid_ts.json",
    "oracle": "npm run grid && tsx scripts/run-oracle.ts grid_ts.json",
    "offers": "tsx scripts/offer-table.ts",
    "bench": "tsx scripts/bench.ts",
    "fetch-rpp": "tsx scripts/fetch-rpp.ts && tsx scripts/build-cities.ts",
    "fetch-fmr": "tsx scripts/fetch-fmr.ts",
    "build-cities": "tsx scripts/build-cities.ts",
    "check-bundle": "tsx scripts/check-bundle.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "fuzz": "tsx scripts/fuzz.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chrome-launcher": "1.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "lighthouse": "13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
